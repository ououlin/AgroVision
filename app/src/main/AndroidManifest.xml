<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== 权限（上架合规：最小化原则） ===== -->

    <!-- 相机：用于实时识别拍摄作物叶片，required=false 让无相机的平板仍可安装（走相册识别/AI聊天/百科） -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 相册通过系统文件选择器访问，不需要申请存储权限。 -->
    <!-- 网络：AI 问答、天气、同步 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 定位：仅 ACCESS_COARSE_LOCATION 用于城市级天气（不需要 GPS 级 FINE），
         不上后台定位；GIS 地图轨迹（V3）如真需要再单独申请 ACCESS_FINE_LOCATION -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 通知：推送病虫害告警、天气提醒、巡检任务状态（Android 13+ 必须显式声明） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AgroVisionApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="农智眼"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgroVision"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.AgroVision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider for camera capture / 相册导出：
             exported=false 并 grantUriPermissions=true 是官方推荐安全配置 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
